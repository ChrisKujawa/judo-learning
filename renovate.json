{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "bump",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Group Vite and Vitest ecosystem updates",
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react",
        "vitest",
        "@vitest/**"
      ],
      "groupName": "Vite ecosystem"
    },
    {
      "description": "Automerge npm and GitHub Actions updates after checks pass",
      "matchManagers": [
        "npm",
        "github-actions"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": true
  }
}
